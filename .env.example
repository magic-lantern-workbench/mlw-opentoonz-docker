# Environment used for the successful build of mlw/opentoonz:ubuntu24.04.
# Copy to .env to use:  cp .env.example .env

# Source repository (SSH; needs a running ssh-agent). For HTTPS use:
#   OPENTOONZ_REPO=https://github.com/WizzerWorks/opentoonz.git
OPENTOONZ_REPO=git@github.com:WizzerWorks/opentoonz.git

# Branch or tag to build. 'magiclantern' carries the GCC 13 / Qt 5 / glibc
# fixes needed to compile on Ubuntu 24.04.
OPENTOONZ_REF=magiclantern

# Commit SHA of OPENTOONZ_REF; changing it forces a fresh git clone instead of a
# cached layer. This is the exact commit that built successfully. To build the
# branch's latest commit instead:
#   git ls-remote https://github.com/WizzerWorks/opentoonz.git magiclantern | cut -f1
OPENTOONZ_REV=e13300f4658f0ce83cb53351e122620e87c05b30

# Parallel compile jobs. 2 keeps the host responsive; 0 = all cores (can freeze the host).
BUILD_JOBS=2

# Container user ids (match the host user). Note: bash does not export UID, so
# docker compose may not see these unless set in .env or on the command line.
UID=1000
GID=1000
